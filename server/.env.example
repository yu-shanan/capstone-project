# MongoDB Atlas connection string (Atlas > Connect > Drivers)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# Secret used to sign JWTs - use a long random string in production
JWT_SECRET=replace-with-a-long-random-string

PORT=5000

# Front-end origin(s) allowed by CORS - comma separated, e.g.
# CLIENT_URL=http://localhost:5173,https://your-app.vercel.app
CLIENT_URL=http://localhost:5173
